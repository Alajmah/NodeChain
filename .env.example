# NodeChain environment configuration template
# Copy to .env and adjust values. Never commit real credentials.

# ── Model Provider ──────────────────────────────────────────────────────────
# Provider: lim | mock | openai_compatible
NODECHAIN_PROVIDER=mock

# ── LLM Configuration (for lim/openai_compatible) ───────────────────────────
# OPENAI_BASE_URL=http://your-llm-host:1234/v1
# OPENAI_API_KEY=your-api-key-here
# NODECHAIN_MODEL=your-model-name

# ── Review Gate ─────────────────────────────────────────────────────────────
# interactive | auto-approve | auto-reject | auto-revision | disabled | pause
NODECHAIN_REVIEW_MODE=auto-approve

# ── Schema Strictness ───────────────────────────────────────────────────────
NODECHAIN_STRICT_SCHEMA=0

# ── Proxmox (optional, for deployment adapter) ──────────────────────────────
# NODECHAIN_PROXMOX_HOST=your-proxmox-host
# NODECHAIN_PROXMOX_USER=root
# NODECHAIN_PROXMOX_TOKEN_ID=USER@REALM!TOKENID
# NODECHAIN_PROXMOX_TOKEN_SECRET=your-token-secret

# ── Governance ──────────────────────────────────────────────────────────────
# NODECHAIN_GOVERNANCE_STRICT=0
# NODECHAIN_DEV_MODE=0

# ── Policy Preset ───────────────────────────────────────────────────────────
# NODECHAIN_POLICY_PRESET=standard_untrusted
# NODECHAIN_POLICY_PRESET_SOURCE=cli

# ── Sandbox Profile ─────────────────────────────────────────────────────────
# NODECHAIN_SANDBOX_PROFILE=python_hooks

# ── Trust Store ─────────────────────────────────────────────────────────────
# NODECHAIN_TRUST_STORE=data/trust_store.json
