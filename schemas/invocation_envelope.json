{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nodechain://schemas/invocation_envelope",
  "title": "InvocationEnvelope",
  "description": "The universal execution contract between runtime and node. Every node invocation and response passes through this envelope.",
  "type": "object",
  "required": ["envelope_id", "run_id", "chain_id", "node_id", "step_id", "timestamp", "payload", "context", "capabilities"],
  "properties": {
    "envelope_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this envelope instance"
    },
    "run_id": {
      "type": "string",
      "format": "uuid",
      "description": "Chain run identifier"
    },
    "chain_id": {
      "type": "string",
      "description": "Chain definition identifier"
    },
    "node_id": {
      "type": "string",
      "description": "Target node identifier"
    },
    "step_id": {
      "type": "integer",
      "minimum": 1,
      "description": "Step number within the chain run"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 envelope creation timestamp"
    },
    "payload": {
      "$ref": "nodechain://schemas/semantic_types/raw_user_query",
      "description": "Input payload conforming to node's entry contract"
    },
    "context": {
      "type": "object",
      "description": "Granted context from control plane",
      "properties": {
        "session_memory": {
          "type": "array",
          "items": { "type": "object" },
          "description": "Memory records granted for this invocation"
        },
        "chain_state": {
          "type": "object",
          "description": "Relevant chain state for this node"
        },
        "source_routing": {
          "type": "object",
          "description": "Per-adapter grants for search nodes",
          "properties": {
            "primary": { "type": "array", "items": { "type": "string" } },
            "secondary": { "type": "array", "items": { "type": "string" } },
            "domain_specific": { "type": "object" }
          }
        },
        "per_node_adapter_grants": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Adapters this node is permitted to invoke"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "description": "Granted capabilities from control plane",
      "properties": {
        "can_call_tools": {
          "type": "boolean",
          "default": false
        },
        "can_read_memory": {
          "type": "boolean",
          "default": false
        },
        "can_write_memory": {
          "type": "boolean",
          "default": false
        },
        "max_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "max_latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "allowed_tools": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Explicit tool grants"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Extensible metadata"
    }
  },
  "additionalProperties": false
}
