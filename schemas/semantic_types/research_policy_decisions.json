{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nodechain://schemas/semantic_types/research_policy_decisions",
  "title": "ResearchPolicyDecisionsV1",
  "description": "Governance / policy decisions recorded during a ResearchWorkspaceBundleV1 run (e.g. memory-write gating).",
  "type": "object",
  "required": ["bundle_version", "run_id", "recorded_at", "policy_decisions"],
  "additionalProperties": false,
  "properties": {
    "bundle_version": {
      "$ref": "nodechain://schemas/semantic_types/research_workspace_definitions#/$defs/bundle_version"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier of the research run these decisions belong to."
    },
    "recorded_at": {
      "$ref": "nodechain://schemas/semantic_types/research_workspace_definitions#/$defs/timestamp"
    },
    "policy_decisions": {
      "type": "array",
      "items": {
        "$ref": "nodechain://schemas/semantic_types/research_workspace_definitions#/$defs/policy_decision"
      },
      "description": "Recorded policy decisions."
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "description": "Version of the policy document that governed these decisions."
    }
  }
}
