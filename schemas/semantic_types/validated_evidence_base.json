{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nodechain://schemas/semantic_types/validated_evidence_base",
  "title": "ValidatedEvidenceBase",
  "description": "Evidence after two-pass validation: structural (deterministic) + consistency (model-backed).",
  "type": "object",
  "required": ["validated_claims", "validation_summary"],
  "properties": {
    "validated_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "statement", "status"],
        "properties": {
          "claim_id": { "type": "string" },
          "statement": { "type": "string" },
          "status": { "type": "string", "enum": ["confirmed", "partially_confirmed", "unconfirmed", "contradicted", "insufficient_evidence"] },
          "structural_validation": {
            "type": "object",
            "properties": {
              "passed": { "type": "boolean" },
              "source_count_adequate": { "type": "boolean" },
              "attribution_complete": { "type": "boolean" },
              "issues": { "type": "array", "items": { "type": "string" } }
            }
          },
          "consistency_validation": {
            "type": "object",
            "properties": {
              "passed": { "type": "boolean" },
              "internal_consistency": { "type": "number" },
              "source_agreement": { "type": "number" },
              "issues": { "type": "array", "items": { "type": "string" } }
            }
          },
          "adjusted_confidence": { "type": "number" },
          "validation_notes": { "type": "string" }
        }
      }
    },
    "validation_summary": {
      "type": "object",
      "properties": {
        "total_claims": { "type": "integer" },
        "confirmed": { "type": "integer" },
        "partially_confirmed": { "type": "integer" },
        "unconfirmed": { "type": "integer" },
        "contradicted": { "type": "integer" },
        "insufficient_evidence": { "type": "integer" },
        "synthesis_preserved": { "type": "boolean" }
      }
    }
  }
}
