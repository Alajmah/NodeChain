{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nodechain://schemas/semantic_types/risk_assessment",
  "title": "RiskAssessment",
  "type": "object",
  "required": ["risk_level", "confidence", "review_required"],
  "properties": {
    "risk_level": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence_factors": {
      "type": "object",
      "properties": {
        "source_quality_mean": { "type": "number" },
        "claim_validation_rate": { "type": "number" },
        "evidence_coverage": { "type": "number" },
        "domain_familiarity": { "type": "number" }
      }
    },
    "review_required": { "type": "boolean" },
    "review_reason": { "type": "string" },
    "uncertainty_disclosures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["area", "nature", "impact"],
        "properties": {
          "area": { "type": "string" },
          "nature": { "type": "string" },
          "impact": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      }
    },
    "risk_factors": { "type": "array", "items": { "type": "string" } }
  }
}
