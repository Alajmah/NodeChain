{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nodechain://schemas/semantic_types/evidence_base",
  "title": "EvidenceBase",
  "type": "object",
  "required": ["claims", "synthesis"],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "statement", "supporting_sources", "confidence"],
        "properties": {
          "claim_id": { "type": "string" },
          "statement": { "type": "string" },
          "supporting_sources": { "type": "array", "items": { "type": "string" } },
          "contradicting_sources": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "uncertainty": { "type": "string" },
          "domain": { "type": "string" }
        }
      }
    },
    "synthesis": {
      "type": "object",
      "required": ["summary", "key_findings", "areas_of_agreement", "areas_of_disagreement"],
      "properties": {
        "summary": { "type": "string" },
        "key_findings": { "type": "array", "items": { "type": "string" } },
        "areas_of_agreement": { "type": "array", "items": { "type": "string" } },
        "areas_of_disagreement": { "type": "array", "items": { "type": "string" } },
        "gaps_identified": { "type": "array", "items": { "type": "string" } },
        "temporal_analysis": { "type": "string" }
      }
    },
    "source_count": { "type": "integer" },
    "memory_context_used": { "type": "boolean" }
  }
}
