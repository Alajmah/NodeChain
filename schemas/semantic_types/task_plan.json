{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nodechain://schemas/semantic_types/task_plan",
  "title": "TaskPlan",
  "type": "object",
  "required": ["plan_id", "tasks", "source_routing"],
  "properties": {
    "plan_id": { "type": "string", "format": "uuid" },
    "research_goal_ref": { "type": "string" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "description", "query_terms"],
        "properties": {
          "task_id": { "type": "string" },
          "description": { "type": "string" },
          "query_terms": { "type": "array", "items": { "type": "string" } },
          "priority": { "type": "integer" },
          "target_domains": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "source_routing": {
      "type": "object",
      "required": ["primary", "secondary"],
      "properties": {
        "primary": {
          "type": "array",
          "items": { "type": "string", "enum": ["semantic_scholar", "arxiv", "openalex", "crossref", "pubmed"] }
        },
        "secondary": {
          "type": "array",
          "items": { "type": "string", "enum": ["semantic_scholar", "arxiv", "openalex", "crossref", "pubmed"] }
        },
        "domain_specific": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string", "enum": ["semantic_scholar", "arxiv", "openalex", "crossref", "pubmed"] }
          }
        }
      }
    },
    "estimated_complexity": { "type": "string", "enum": ["simple", "moderate", "complex"] },
    "revision_of": { "type": "string", "description": "plan_id of previous plan if this is a revision" },
    "revision_reason": { "type": "string" }
  }
}
