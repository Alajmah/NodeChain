{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nodechain://schemas/semantic_types/source_set",
  "title": "SourceSet",
  "description": "Normalized set of source records after ingestion, unified across all API origins.",
  "type": "object",
  "required": ["sources"],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "origin_api", "title", "provenance"],
        "properties": {
          "source_id": { "type": "string" },
          "origin_api": {
            "type": "string",
            "enum": ["semantic_scholar", "arxiv", "openalex", "crossref", "pubmed", "chroma_local"]
          },
          "title": { "type": "string" },
          "authors": { "type": "array", "items": { "type": "string" } },
          "publication_date": { "type": "string" },
          "doi": { "type": "string" },
          "abstract": { "type": "string" },
          "source_type": {
            "type": "string",
            "enum": ["journal_article", "preprint", "conference", "review", "book", "thesis", "other"]
          },
          "peer_reviewed": { "type": "boolean" },
          "citation_count": { "type": "integer" },
          "venue": { "type": "string" },
          "subject_areas": { "type": "array", "items": { "type": "string" } },
          "open_access": { "type": "boolean" },
          "pdf_url": { "type": "string" },
          "credibility_signals": { "type": "object", "additionalProperties": true },
          "provenance": {
            "oneOf": [
              {
                "type": "object",
                "required": ["mode", "version", "entries", "adapter", "query", "retrieval_timestamp"],
                "properties": {
                  "mode": { "type": "string", "const": "current" },
                  "version": { "type": "integer", "const": 1 },
                  "entries": {
                    "type": "array", "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["version", "adapter", "query", "retrieval_timestamp"],
                      "properties": {
                        "version": { "type": "integer", "const": 1 },
                        "adapter": { "type": "string", "minLength": 1 },
                        "query": { "type": "string", "minLength": 1 },
                        "retrieval_timestamp": { "type": "string", "minLength": 1, "format": "date-time" }
                      }
                    }
                  },
                  "adapter": { "type": "string" },
                  "query": { "type": "string" },
                  "retrieval_timestamp": { "type": "string", "format": "date-time" }
                }
              },
              {
                "type": "object",
                "required": ["mode", "version", "entries", "adapter", "query", "retrieval_timestamp"],
                "properties": {
                  "mode": { "type": "string", "const": "legacy" },
                  "version": { "type": "integer", "const": 0 },
                  "entries": {
                    "type": "array", "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["version", "adapter", "query", "retrieval_timestamp"],
                      "properties": {
                        "version": { "type": "integer", "const": 0 },
                        "adapter": { "type": "string", "minLength": 1 },
                        "query": { "type": "string", "minLength": 1 },
                        "retrieval_timestamp": { "type": "string", "minLength": 1, "format": "date-time" }
                      }
                    }
                  },
                  "adapter": { "type": "string" },
                  "query": { "type": "string" },
                  "retrieval_timestamp": { "type": "string", "format": "date-time" }
                }
              },
              {
                "type": "object",
                "required": ["mode", "version", "entries", "adapter", "query", "retrieval_timestamp"],
                "properties": {
                  "mode": { "type": "string", "const": "pre_version" },
                  "version": { "type": "null" },
                  "entries": {
                    "type": "array", "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["version", "adapter", "query", "retrieval_timestamp"],
                      "properties": {
                        "version": { "type": "null" },
                        "adapter": { "type": "string", "minLength": 1 },
                        "query": { "type": "string", "minLength": 1 },
                        "retrieval_timestamp": { "type": "string", "minLength": 1, "format": "date-time" }
                      }
                    }
                  },
                  "adapter": { "type": "string" },
                  "query": { "type": "string" },
                  "retrieval_timestamp": { "type": "string", "format": "date-time" }
                }
              }
            ]
          }
        }
      }
    },
    "ingestion_stats": {
      "type": "object",
      "properties": {
        "total_raw": { "type": "integer" },
        "total_normalized": { "type": "integer" },
        "duplicates_removed": { "type": "integer" },
        "by_origin": { "type": "object", "additionalProperties": { "type": "integer" } }
      }
    }
  }
}
