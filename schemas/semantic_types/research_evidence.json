{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nodechain://schemas/semantic_types/research_evidence",
  "title": "ResearchEvidenceV1",
  "description": "Extracted evidence fragments for a ResearchWorkspaceBundleV1 run.",
  "type": "object",
  "required": ["bundle_version", "run_id", "extracted_at", "evidence"],
  "additionalProperties": false,
  "properties": {
    "bundle_version": {
      "$ref": "nodechain://schemas/semantic_types/research_workspace_definitions#/$defs/bundle_version"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier of the research run this evidence belongs to."
    },
    "extracted_at": {
      "$ref": "nodechain://schemas/semantic_types/research_workspace_definitions#/$defs/timestamp"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "nodechain://schemas/semantic_types/research_workspace_definitions#/$defs/evidence_record"
      },
      "description": "Extracted evidence records."
    },
    "extraction_model": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier of the model used to extract evidence."
    },
    "mean_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Mean extraction confidence across all records."
    }
  }
}
