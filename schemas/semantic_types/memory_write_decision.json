{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nodechain://schemas/semantic_types/memory_write_decision",
  "title": "MemoryWriteDecision",
  "type": "object",
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["memory_id", "scope", "subject", "content", "confidence", "sensitivity", "provenance"],
        "properties": {
          "memory_id": { "type": "string", "format": "uuid" },
          "scope": { "type": "string", "enum": ["task_memory", "session_memory", "persistent_memory"] },
          "subject": { "type": "string" },
          "content": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "sensitivity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
          "retention_policy": { "type": "string", "enum": ["session", "7d", "30d", "permanent"] },
          "provenance": {
            "type": "object",
            "required": ["chain_id", "run_id", "source_ids", "generation_timestamp"],
            "properties": {
              "chain_id": { "type": "string" },
              "run_id": { "type": "string" },
              "source_ids": { "type": "array", "items": { "type": "string" } },
              "generation_timestamp": { "type": "string", "format": "date-time" }
            }
          },
          "owner": { "type": "string" },
          "policy_decision": {
            "type": "object",
            "properties": {
              "approved": { "type": "boolean" },
              "reason": { "type": "string" },
              "policy_id": { "type": "string" }
            }
          },
          "validation_result": {
            "type": "object",
            "properties": {
              "passed": { "type": "boolean" },
              "issues": { "type": "array", "items": { "type": "string" } }
            }
          },
          "write_result": {
            "type": "object",
            "properties": {
              "committed": { "type": "boolean" },
              "write_ref": { "type": "string" },
              "blocked_reason": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
